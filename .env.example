# Copie para .env e ajuste. Nenhum destes valores é secreto.
# O app não tem banco nem diretório de dados: o arquivo enviado só existe na
# memória durante o request e nada é gravado em disco.

# --- Backend (FastAPI) ---
# Porta interna. Só o Next fala com ela; não precisa ficar exposta na internet.
API_PORT=8077
API_HOST=127.0.0.1

MAX_UPLOAD_MB=15

# Só é usado se o navegador chamar o backend direto (fora do rewrite do Next).
CORS_ORIGINS=http://localhost:3007

# --- Frontend (Next.js) ---
PORT=3007
BACKEND_URL=http://127.0.0.1:8077
