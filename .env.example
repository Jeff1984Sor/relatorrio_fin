# Copie para .env e ajuste. Nenhum destes valores é secreto nesta versão.

# --- Backend (FastAPI) ---
# Porta interna. Só o Next fala com ela; não precisa ficar exposta na internet.
API_PORT=8077
API_HOST=127.0.0.1

# SQLite. O arquivo é criado sozinho no primeiro start.
DATABASE_URL=sqlite:////root/apps/relatorio_fin/backend/data/relatorio_fin.db
DATA_DIR=/root/apps/relatorio_fin/backend/data
STORAGE_DIR=/root/apps/relatorio_fin/backend/data/arquivos

MAX_UPLOAD_MB=15
USUARIO_PADRAO=escritorio

# Só é usado se o navegador chamar o backend direto (fora do rewrite do Next).
CORS_ORIGINS=http://localhost:3007

# --- Frontend (Next.js) ---
PORT=3007
BACKEND_URL=http://127.0.0.1:8077
