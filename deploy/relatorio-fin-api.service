[Unit]
Description=Relatorio Fin - API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/apps/relatorio_fin/backend

Environment="DATA_DIR=/root/apps/relatorio_fin/backend/data"
Environment="STORAGE_DIR=/root/apps/relatorio_fin/backend/data/arquivos"
Environment="DATABASE_URL=sqlite:////root/apps/relatorio_fin/backend/data/relatorio_fin.db"
Environment="MAX_UPLOAD_MB=15"
Environment="USUARIO_PADRAO=escritorio"

ExecStart=/root/apps/relatorio_fin/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8077 --workers 2

Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=relatorio-fin-api

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
